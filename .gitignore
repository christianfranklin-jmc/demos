# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
# 002-dsa-hub-pinnacle US3 — explicitly track the Build-page React components
# even though the bare `build/` pattern matches at any depth.
!frontend/src/components/build/
!frontend/src/components/build/**
.venv/
venv/

# Environment — never commit real env files. Templates ending in .example
# (and the dsa-specific frontend/.env.example.dsa) are explicitly allowed.
.env
.env.*
.envrc
!.env.example
!frontend/.env.example
!frontend/.env.example.dsa

# Secrets / credentials / keys (defence in depth)
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
*.kdbx
.aws/credentials
.aws/config
**/credentials.json
**/secrets.json
**/secrets.yaml
**/secrets.yml
auth.json
.netrc
cookies.txt
*.snowflake-jwt
.snowflake/

# Terraform — extra coverage (.tfvars anywhere, plan files, .terraformrc)
*.tfvars
*.tfvars.json
!*.tfvars.example
*.tfplan
.terraformrc
terraform.rc

# Local databases — may contain real customer data
*.db
*.sqlite
*.sqlite3
*.duckdb

# Generic dump / scratch files developers sometimes leak
*.bak
*.swp
.scratch/
scratch/

# Python venvs (extras)
env/
ENV/

# Node / pnpm
.npmrc
.yarnrc
.yarnrc.yml
.pnpm-store/

# IDE
.vscode/
.idea/
*.swp
*.swo

# dbt
dbt_output/*/target/
dbt_output/*/dbt_packages/
dbt_output/*/logs/
dbt_output/*/profiles.yml
dbt_output/*/package-lock.yml

# Streamlit
streamlit_app/.streamlit/secrets.toml

# AWS / AgentCore
.bedrock_agentcore.yaml

# Build artifacts
.build/

# Terraform
infra-terraform/.terraform/
infra-terraform/*.tfstate
infra-terraform/*.tfstate.*
infra-terraform/.terraform.lock.hcl
infra-terraform/terraform.tfvars

# Frontend
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
frontend/.vite/
.vite/

# phData Toolkit
toolkit.conf
/lib/
logs/
/tools/ds/
.toolkit-metadata

# Keep these tracked despite lib/ and tools/ patterns
!frontend/src/lib/
!tools/code_interpreter/
!tools/__init__.py

# dbt user config
dbt_output/*/.user.yml

# Claude Code
.claude/

# OS
.DS_Store
Thumbs.db

# Compiled / packaged binaries (carried over from Bitbucket initial .gitignore)
*.class
*.jar
*.war
*.app
*.exe
target/

# Logs
*.log

# Tests
TEST*.xml

# Large media (avoid accidentally committing demo recordings)
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
