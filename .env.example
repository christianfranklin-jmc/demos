# AWS Platform Agent — Environment Variables
# Copy to .env and fill in values. Generated automatically by scripts/bootstrap.sh.

# AWS credentials
AWS_PROFILE=AdministratorAccess-637119802057
AWS_DEFAULT_REGION=us-east-1

# Database connection (RDS PostgreSQL or Redshift)
DB_HOST=platform-agent-northwinds.XXXX.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=northwinds
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_DRIVER_TYPE=postgresql  # or "redshift"

# AgentCore (set by Terraform outputs)
# MEMORY_ID=                   # AgentCore Memory resource ID
# GATEWAY_URL=                 # AgentCore Gateway MCP endpoint
# STACK_NAME=                  # Terraform stack name
# COGNITO_POOL_ID=             # Cognito User Pool ID
# COGNITO_CLIENT_ID=           # Cognito web client ID
# COGNITO_DOMAIN=              # Cognito hosted UI domain

# Snowflake connection (for snow-iceberg-migration)
SF_ACCOUNT=lga76011
SF_USER=user@example.com
SF_AUTHENTICATOR=externalbrowser
SF_ROLE=ALL_ML_ARCHITECTS
SF_WAREHOUSE=COMPUTE_WH
SF_DATABASE=PINNACLE_FINANCIAL_DEMO_ASINGH
SF_SCHEMA=ANALYTICS
# SF_PASSWORD=                  # Only if not using externalbrowser auth

# Redshift connection (for Redshift Serverless)
RS_HOST=platform-agent-wg.XXXX.us-east-1.redshift-serverless.amazonaws.com
RS_PORT=5439
RS_DATABASE=dev
RS_USER=admin
RS_PASSWORD=CHANGE_ME

# dbt MCP Server
# DBT_HOST=                     # dbt Cloud host (or leave blank for dbt Core)
# DBT_TOKEN=                    # dbt Cloud API token
# DBT_PROD_ENV_ID=              # dbt Cloud production environment ID

# Optional: Toolkit CLI path override
# TOOLKIT_CLI=~/toolkit-cli-0.90.0/toolkit

# 001-dsa-agent-integration: thin FastAPI SSE layer
API_PORT=8080
SESSION_HEADER_NAME=X-DSA-Session-ID
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
AGENT_MODE=local  # or "deployed"
BUILD_SHA=dev

# 002-dsa-hub-pinnacle: cross-source hub
STORAGE_BACKEND=local                        # "local" (~/.dsa-hub/connections/<id>/) or "dynamodb"
DSA_HUB_VALIDATION_THRESHOLD=0.80            # Q5: pass-rate gate to promote provisional → final
DSA_HUB_DUCKDB_JOIN_CAP=5000                 # FR-018 joined-result cap (cross-source TTYD)
DSA_HUB_SOURCE_PULL_CAP=250                  # FR-018 per-source pull cap (cross-source TTYD)
# ICEBERG_DEFAULT_GLUE_DB=                   # optional pre-config of a Glue DB suggested in the Add Connection modal
# DSA_HUB_DEMO_MODE=1                        # set to enable canned Pinnacle multi-source scenario (frontend-only fallback)
# DSA_HUB_CONNECTIONS_DIR=~/.dsa-hub/connections   # override per-connection durable store root (local mode)
