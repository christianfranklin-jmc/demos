{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "streamlit",
      "runtimeExecutable": ".venv/bin/streamlit",
      "runtimeArgs": ["run", "streamlit_app/app.py", "--server.port", "8501"],
      "port": 8501
    },
    {
      "name": "frontend",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "cd frontend && /opt/homebrew/bin/node node_modules/.bin/vite"],
      "port": 3000
    }
  ]
}
