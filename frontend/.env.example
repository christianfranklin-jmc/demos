# Agent endpoint (local dev or AgentCore Runtime)
VITE_AGENT_URL=http://localhost:8080

# AgentCore Runtime (set both to enable AgentCore mode)
VITE_AGENTCORE_RUNTIME_ARN=
VITE_AGENTCORE_REGION=us-east-1
VITE_AGENTCORE_PATTERN=strands-single-agent

# Cognito (optional — leave blank to skip auth)
VITE_COGNITO_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_URI=http://localhost:3000
